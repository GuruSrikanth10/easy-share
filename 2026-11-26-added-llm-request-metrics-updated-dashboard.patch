+@contextmanager
+def llm_request(node: str, model: str, classify=None):
+    """Count and time one model request, holding it in LLM_REQUESTS_IN_FLIGHT
+    while it runs.
+
+    Yields a dict on which the caller sets the reply's `finish_reason`,
+    `input_tokens` and `output_tokens`, as far as the model server reported
+    them. A reply cut off at its token limit (finish_reason `length`) is
+    counted `truncated`; a request that raises, under `classify(error)` --
+    `error` without a classifier -- and the exception goes on unchanged.
+    """
+    reply: dict = {}
+    outcome = "error"
+    started = time.monotonic()
+    try:
+        with _held(LLM_REQUESTS_IN_FLIGHT, node=node, model=model):
+            yield reply
+        outcome = "truncated" if reply.get("finish_reason") == "length" else "ok"
+    except Exception as error:
+        outcome = _outcome_of(error, classify)
+        raise
+    finally:
+        _record_llm_request(node, model, outcome, time.monotonic() - started, reply)
+
+
+@contextmanager
+def waiting_for_llm_slot():
+    """Hold a wait for a model-call slot in LLM_REQUESTS_WAITING."""
+    with _held(LLM_REQUESTS_WAITING):
+        yield
+
+
+@_never_raises
+def record_llm_slot_wait(seconds: float) -> None:
+    LLM_SLOT_WAIT.observe(seconds)
+
+
+@_never_raises
+def record_llm_request_slots(slots: int) -> None:
+    LLM_REQUEST_SLOTS.set(slots)
+
+
+@contextmanager
+def _held(gauge, **labels):
+    """Raise `gauge` by one for the block. Never raises, and a gauge that
+    could not be raised is not lowered either, so it cannot drift."""
+    held = None
+    try:
+        held = gauge.labels(**labels) if labels else gauge
+        held.inc()
+    except Exception as e:
+        held = None
+        logger.debug("Could not record a metric", metric="gauge", error=str(e))
+    try:
+        yield
+    finally:
+        if held is not None:
+            try:
+                held.dec()
+            except Exception as e:
+                logger.debug("Could not record a metric", metric="gauge", error=str(e))
+
+
+@_never_raises
+def _record_llm_request(node: str, model: str, outcome: str, seconds: float,
+                        reply: dict) -> None:
+    LLM_REQUEST_DURATION.labels(node=node, model=model, outcome=outcome).observe(seconds)
+    for direction in ("input", "output"):
+        tokens = reply.get(f"{direction}_tokens")
+        if isinstance(tokens, int) and tokens > 0:
+            LLM_REQUEST_TOKENS.labels(node=node, model=model,
+                                      direction=direction).observe(tokens)
+
