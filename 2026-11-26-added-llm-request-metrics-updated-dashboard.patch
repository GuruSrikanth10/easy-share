@@ -0,0 +1,291 @@
+"""
+The LLM metrics: each model request an agent sends, timed and counted under
+its node and model by the middleware every agent carries
+(core/agent_factory.ModelRequestMetricsMiddleware), and the model-call slots
+those requests take and wait for (utils/resilience).
+
+The agent tests build real deep agents around a scripted chat model, as
+test_agent_factory.py does, so the middleware runs where it runs in
+production: inside the slot, for the agent and for its `task` subagent.
+"""
+import asyncio
+import threading
+import time
+from types import SimpleNamespace
+
+import httpx
+import openai
+import pytest
+from langchain.agents.middleware.types import ModelResponse
+from langchain_core.language_models.chat_models import BaseChatModel
+from langchain_core.messages import AIMessage, HumanMessage
+from langchain_core.outputs import ChatGeneration, ChatResult
+
+from src.core import run_control
+from src.core.agent_factory import ModelRequestMetricsMiddleware, build_agent
+from src.core.run_control import RunCancelled
+from src.utils import metrics, resilience
+
+pytestmark = pytest.mark.skipif(not metrics.METRICS_AVAILABLE,
+                                reason="prometheus_client is an optional dependency")
+
+MODEL = "glm-test"
+URL = "http://model.test/v1/chat/completions"
+
+
+def _samples(metric, suffix) -> dict:
+    return {tuple(sorted(sample.labels.items())): sample.value
+            for family in metric.collect() for sample in family.samples
+            if sample.name.endswith(suffix)}
+
+
+def _moved(metric, suffix, act) -> dict:
+    """{labels: increase} of the `suffix` samples of `metric` that `act()` moved."""
+    before = _samples(metric, suffix)
+    act()
+    after = _samples(metric, suffix)
+    return {labels: value - before.get(labels, 0)
+            for labels, value in after.items() if value != before.get(labels, 0)}
+
+
+def _recorded(act) -> tuple:
+    """The requests `act()` counted, and the tokens it recorded."""
+    requests = {}
+    tokens = _moved(metrics.LLM_REQUEST_TOKENS, "_sum",
+                    lambda: requests.update(_moved(metrics.LLM_REQUEST_DURATION, "_count", act)))
+    return requests, tokens
+
+
+def _request(node, outcome, model=MODEL):
+    return (("model", model), ("node", node), ("outcome", outcome))
+
+
+def _tokens(node, direction, model=MODEL):
+    return (("direction", direction), ("model", model), ("node", node))
+
+
+def _reply(content="ok", finish_reason="stop", usage=None):
+    return AIMessage(content=content, response_metadata={"finish_reason": finish_reason},
+                     usage_metadata=usage)
+
+
+def _call(node="investigator", reply=None, error=None):
+    """One model request through the middleware, answered by `reply` or failing with `error`."""
+    request = SimpleNamespace(model=SimpleNamespace(model_name=MODEL))
+
+    def handler(_request):
+        if error is not None:
+            raise error
+        return ModelResponse(result=[reply or _reply()])
+
+    return ModelRequestMetricsMiddleware(node).wrap_model_call(request, handler)
+
+
+# ======================================================================
+# Each request
+# ======================================================================
+
+def test_a_request_is_counted_and_timed_with_its_tokens():
+    usage = {"input_tokens": 1200, "output_tokens": 300, "total_tokens": 1500}
+
+    assert _recorded(lambda: _call(reply=_reply(usage=usage))) == (
+        {_request("investigator", "ok"): 1},
+        {_tokens("investigator", "input"): 1200, _tokens("investigator", "output"): 300})
+
+
+def test_a_reply_cut_off_at_its_token_limit_is_truncated():
+    assert _recorded(lambda: _call("synthesis", reply=_reply(finish_reason="length"))) == (
+        {_request("synthesis", "truncated"): 1}, {})
+
+
+def test_a_reply_without_usage_records_no_tokens():
+    assert _recorded(lambda: _call("reviewer")) == ({_request("reviewer", "ok"): 1}, {})
+
+
+def _status_error(cls, status):
+    request = httpx.Request("POST", URL)
+    return cls("refused", response=httpx.Response(status, request=request), body=None)
+
+
+@pytest.mark.parametrize("error, outcome", [
+    (openai.APITimeoutError(request=httpx.Request("POST", URL)), "timeout"),
+    (openai.APIConnectionError(request=httpx.Request("POST", URL)), "unreachable"),
+    (_status_error(openai.RateLimitError, 429), "http_429"),
+    (_status_error(openai.BadRequestError, 400), "http_400"),
+    (_status_error(openai.InternalServerError, 503), "http_503"),
+    (httpx.ReadTimeout("read timed out"), "timeout"),
+    (httpx.ConnectError("connection refused"), "unreachable"),
+    (httpx.HTTPStatusError("bad gateway", request=httpx.Request("POST", URL),
+                           response=httpx.Response(502, request=httpx.Request("POST", URL))),
+     "http_502"),
+    (ValueError("an unreadable reply"), "error"),
+], ids=lambda value: value if isinstance(value, str) else type(value).__name__)
+def test_a_failed_request_is_counted_by_how_it_ended_and_still_raises(error, outcome):
+    def call():
+        with pytest.raises(type(error)):
+            _call("dlt_investigator", error=error)
+
+    assert _recorded(call) == ({_request("dlt_investigator", outcome): 1}, {})
+
+
+def test_a_request_is_in_flight_until_it_ends_however_it_ends():
+    gauge = metrics.LLM_REQUESTS_IN_FLIGHT.labels(node="log_filter", model=MODEL)
+    before = gauge._value.get()
+    seen = []
+    request = SimpleNamespace(model=SimpleNamespace(model_name=MODEL))
+    middleware = ModelRequestMetricsMiddleware("log_filter")
+
+    def answers(_request):
+        seen.append(gauge._value.get())
+        return ModelResponse(result=[_reply()])
+
+    def fails(_request):
+        seen.append(gauge._value.get())
+        raise openai.APITimeoutError(request=httpx.Request("POST", URL))
+
+    middleware.wrap_model_call(request, answers)
+    with pytest.raises(openai.APITimeoutError):
+        middleware.wrap_model_call(request, fails)
+
+    assert seen == [before + 1, before + 1]
+    assert gauge._value.get() == before
+
+
+def test_an_async_request_is_recorded_too():
+    request = SimpleNamespace(model=SimpleNamespace(model_name=MODEL))
+
+    async def handler(_request):
+        return ModelResponse(result=[_reply(usage={"input_tokens": 10, "output_tokens": 2,
+                                                   "total_tokens": 12})])
+
+    def call():
+        asyncio.run(ModelRequestMetricsMiddleware("reviewer").awrap_model_call(request, handler))
+
+    assert _recorded(call) == ({_request("reviewer", "ok"): 1},
+                               {_tokens("reviewer", "input"): 10, _tokens("reviewer", "output"): 2})
+
+
+# ======================================================================
+# In a real agent
+# ======================================================================
+
+class ScriptedModel(BaseChatModel):
+    """Replies from a list, named as a ChatMistralAI names its model."""
+
+    model: str = MODEL
+    replies: list
+
+    def _generate(self, messages, stop=None, run_manager=None, **kwargs):
+        return ChatResult(generations=[ChatGeneration(message=self.replies.pop(0))])
+
+    def bind_tools(self, tools, **kwargs):
+        return self
+
+    @property
+    def _llm_type(self):
+        return "scripted"
+
+
+def test_every_request_of_an_agent_and_its_subagent_is_counted_under_its_role():
+    model = ScriptedModel(replies=[
+        AIMessage(content="", tool_calls=[{"name": "task", "id": "t1", "args": {
+            "description": "look it up", "subagent_type": "general-purpose"}}]),
+        AIMessage(content="subagent report"),
+        AIMessage(content="MAIN"),
+    ])
+    agent = build_agent("synthesis", model, "ROLE", pack="enu-biometric")
+
+    result = {}
+    requests, _ = _recorded(lambda: result.update(
+        agent.invoke({"messages": [HumanMessage(content="go")]})))
+
+    assert result["messages"][-1].content == "MAIN"
+    assert requests == {_request("synthesis", "ok"): 2, _request("synthesis_subagent", "ok"): 1}
+
+
+# ======================================================================
+# The model-call slots
+# ======================================================================
+
+@pytest.fixture
+def slots(monkeypatch):
+    """Model-call slots sized afresh for the test, and forgotten after."""
+    def size(limit):
+        monkeypatch.setenv("LLM_MAX_CONCURRENT_CALLS", str(limit))
+        resilience.reset_model_call_slots()
+    yield size
+    resilience.reset_model_call_slots()
+
+
+def _waits(act) -> tuple:
+    """How many slot waits `act()` timed, and their seconds."""
+    seconds = {}
+    count = _moved(metrics.LLM_SLOT_WAIT, "_count",
+                   lambda: seconds.update(_moved(metrics.LLM_SLOT_WAIT, "_sum", act)))
+    return sum(count.values()), sum(seconds.values())
+
+
+def test_the_slots_are_published_when_they_are_sized(slots):
+    slots(3)
+    resilience._slots()
+    assert metrics.LLM_REQUEST_SLOTS._value.get() == 3
+
+
+def test_a_slot_taken_at_once_is_a_wait_of_nothing(slots):
+    slots(2)
+
+    def take():
+        with resilience.model_call_slot():
+            pass
+
+    assert _waits(take) == (1, 0)
+
+
+def test_a_request_that_waits_for_a_slot_is_counted_waiting_then_timed(slots):
+    slots(1)
+    waiting = metrics.LLM_REQUESTS_WAITING._value
+    before = waiting.get()
+    seen = []
+
+    def wait_for_the_slot():
+        resilience.acquire_model_call_slot()
+        resilience.release_model_call_slot()
+
+    def act():
+        resilience.acquire_model_call_slot()
+        thread = threading.Thread(target=wait_for_the_slot)
+        thread.start()
+        deadline = time.monotonic() + 5
+        while waiting.get() == before and time.monotonic() < deadline:
+            time.sleep(0.01)
+        seen.append(waiting.get())
+        time.sleep(0.2)
+        resilience.release_model_call_slot()
+        thread.join(5)
+
+    count, seconds = _waits(act)
+
+    assert seen == [before + 1]
+    assert waiting.get() == before
+    # Its own wait, and the first one's: none.
+    assert count == 2
+    assert seconds >= 0.2
+
+
+def test_a_wait_the_run_gave_up_is_not_timed(slots):
+    slots(1)
+    waiting = metrics.LLM_REQUESTS_WAITING._value
+    before = waiting.get()
+    resilience.acquire_model_call_slot()
+    try:
+        cancel = threading.Event()
+        cancel.set()
+
+        def give_up():
+            with run_control.scope(cancel), pytest.raises(RunCancelled):
+                resilience.acquire_model_call_slot()
+
+        assert _waits(give_up) == (0, 0)
+        assert waiting.get() == before
+    finally:
+        resilience.release_model_call_slot()
