+#: The columns this saver writes, per table: the column lists of
+#: langgraph-checkpoint-mysql's INSERT statements, which also cover every
+#: column it reads (tests/test_mysql_checkpointer.py checks them against the
+#: installed version). The existing tables are used only if they have all of
+#: them.
+REQUIRED_COLUMNS = {
+    "checkpoints": ("thread_id", "checkpoint_ns", "checkpoint_ns_hash", "checkpoint_id",
+                    "parent_checkpoint_id", "checkpoint", "metadata"),
+    "checkpoint_blobs": ("thread_id", "checkpoint_ns", "checkpoint_ns_hash", "channel",
