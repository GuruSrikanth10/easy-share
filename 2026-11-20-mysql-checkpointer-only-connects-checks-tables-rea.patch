+    "checkpoint_writes": ("thread_id", "checkpoint_ns", "checkpoint_ns_hash", "checkpoint_id",
+                          "task_id", "task_path", "idx", "channel", "type", "blob"),
+}
+
+#: A computed column, which refuses the value this saver writes into
+#: `checkpoint_ns_hash`. `DEFAULT_GENERATED` (an expression default) is not one.
+_GENERATED = re.compile(r"\b(VIRTUAL|STORED|PERSISTENT) GENERATED\b", re.IGNORECASE)
+
+
+class CheckpointTablesError(RuntimeError):
+    """The checkpoint tables cannot take what this saver writes."""
+
 
