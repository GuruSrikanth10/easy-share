@@ -57,9 +81,53 @@ class ReconnectingPyMySQLSaver(PyMySQLSaver):
             pass  # Already closed, which is why it is being replaced.
         self.conn = self._connect()
 
+    def check_tables(self) -> None:
+        """Check, only reading, that the checkpoint tables can take this
+        saver's rows. Raises `CheckpointTablesError` when they cannot.
+
+        This app connects to tables that already exist, and never runs
+        `setup()`: it migrates the tables as if it had made them, and on
+        2026-11-20 it ran ALTER TABLE on another application's
+        checkpoint_blobs, then failed on an index those tables already had
+        ("Duplicate key name 'checkpoints_thread_id_idx'"), on every start.
+        Sharing the tables is safe for the rows: every query names the
+        thread, and this app's thread ids are its event ids.
+        """
+        with self._cursor() as cur:
+            # Aliased: MySQL 8 labels information_schema columns in upper case.
+            cur.execute("SELECT table_name AS tbl, column_name AS col, extra AS extra "
+                        "FROM information_schema.columns WHERE table_schema = DATABASE()")
+            columns = {(row["tbl"], row["col"]): row["extra"] or "" for row in cur.fetchall()}
+        problems = _unusable(columns)
+        if problems:
+            raise CheckpointTablesError(
+                "The checkpoint tables in CHECKPOINT_MYSQL_URI's database cannot take "
+                "this app's rows (langgraph-checkpoint-mysql "
+                f"{importlib.metadata.version('langgraph-checkpoint-mysql')}): "
+                f"{'; '.join(problems)}. This app only connects to them; it never "
+                "creates or alters tables, and nothing was changed.")
+
     def ping(self) -> None:
         """Run a query, reconnecting first if MySQL closed the connection.
         Raises when MySQL cannot be reached. For /ready
         (`checkpointer.health_check`)."""
         with self._cursor() as cur:
             cur.execute("SELECT 1")
+
+
+def _unusable(columns: dict) -> list:
+    """Why the checkpoint tables cannot take this saver's rows, given
+    {(table, column): EXTRA} from information_schema; empty when they can."""
+    problems = []
+    for table, needed in REQUIRED_COLUMNS.items():
+        have = {column for (owner, column) in columns if owner == table}
+        if not have:
+            problems.append(f"there is no {table} table")
+            continue
+        missing = [column for column in needed if column not in have]
+        if missing:
+            problems.append(f"{table} has no {', '.join(missing)}")
+        if _GENERATED.search(columns.get((table, "checkpoint_ns_hash"), "")):
+            problems.append(f"{table}.checkpoint_ns_hash is a generated column, "
+                            "which cannot take the value this saver writes")
+    return problems
