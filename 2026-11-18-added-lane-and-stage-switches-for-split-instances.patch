+"""Which consumers start.py starts (src/utils/consumer_roles.py).
+
+REJECTION_ENABLED and DLT_ENABLED choose the lanes, FETCH_STAGE_ENABLED and
+ANALYSIS_STAGE_ENABLED the stages of each, so one image can run as separate
+deployments: one fetching both lanes' logs, one analysing rejections, one
+analysing dead letters. Unset, they must start exactly what start.py always
+did.
+
+The supervisor tests drive the real `start.main()` with only its child
+processes and its HTTP probes faked, so they check what is actually started,
+in what order, and what is refused before anything starts.
+"""
+import itertools
+import signal
+import subprocess
+import time
+from pathlib import Path
+from types import SimpleNamespace
+
+import pytest
+
+from src.utils import consumer_roles
+
+REPO = Path(__file__).resolve().parents[1]
+
+SWITCHES = ("REJECTION_ENABLED", "DLT_ENABLED", "FETCH_STAGE_ENABLED",
+            "ANALYSIS_STAGE_ENABLED")
+
+#: Each consumer's script, the CONSUMER_ROLE it sets, and the lane and stage
+#: switches that must both be on for it to start -- written out here rather
+#: than read from the module, so the module's own table is checked too. In
+#: the order start.py has always started them.
+EXPECTED = {
+    "src/fast_consumer.py": ("fast", "REJECTION_ENABLED", "FETCH_STAGE_ENABLED"),
+    "src/slow_consumer.py": ("slow", "REJECTION_ENABLED", "ANALYSIS_STAGE_ENABLED"),
+    "src/dlt_consumer.py": ("dlt", "DLT_ENABLED", "FETCH_STAGE_ENABLED"),
+    "src/dlt_analysis_consumer.py": ("dlt_analysis", "DLT_ENABLED",
+                                     "ANALYSIS_STAGE_ENABLED"),
+}
+
+#: The three deployments the switches exist for.
+FETCH_INSTANCE = {"REJECTION_ENABLED": "true", "DLT_ENABLED": "true",
+                  "FETCH_STAGE_ENABLED": "true", "ANALYSIS_STAGE_ENABLED": "false"}
+REJECTION_ANALYSIS_INSTANCE = {"REJECTION_ENABLED": "true", "DLT_ENABLED": "false",
+                               "FETCH_STAGE_ENABLED": "false",
+                               "ANALYSIS_STAGE_ENABLED": "true"}
+DLT_ANALYSIS_INSTANCE = {"REJECTION_ENABLED": "false", "DLT_ENABLED": "true",
+                         "FETCH_STAGE_ENABLED": "false", "ANALYSIS_STAGE_ENABLED": "true"}
+
+LAYOUTS = [
+    (FETCH_INSTANCE, ["src/fast_consumer.py", "src/dlt_consumer.py"]),
+    (REJECTION_ANALYSIS_INSTANCE, ["src/slow_consumer.py"]),
+    (DLT_ANALYSIS_INSTANCE, ["src/dlt_analysis_consumer.py"]),
+]
+LAYOUT_IDS = ["fetch", "rejection-analysis", "dlt-analysis"]
+
+
+def _set(monkeypatch, settings, storage="s3"):
+    for name, value in settings.items():
+        monkeypatch.setenv(name, value)
+    monkeypatch.setenv("CASEBOOK_STORAGE_BACKEND", storage)
+
+
+def _scripts():
+    return [consumer.script for consumer in consumer_roles.selected()]
+
+
+# ======================================================================
+# Which consumers are selected
+# ======================================================================
+
+def test_unset_switches_start_what_start_py_always_started():
+    assert _scripts() == ["src/fast_consumer.py", "src/slow_consumer.py"]
+    assert consumer_roles.validate() == []
+
+
+def test_dlt_enabled_still_adds_both_dlt_consumers(monkeypatch):
+    monkeypatch.setenv("DLT_ENABLED", "true")
+    assert _scripts() == list(EXPECTED)
+
+
+@pytest.mark.parametrize(
+    "values", list(itertools.product((True, False), repeat=len(SWITCHES))),
+    ids=lambda values: "-".join("on" if value else "off" for value in values))
+def test_a_consumer_starts_exactly_when_its_lane_and_its_stage_are_on(monkeypatch, values):
+    settings = dict(zip(SWITCHES, values))
+    for name, on in settings.items():
+        monkeypatch.setenv(name, "true" if on else "false")
+    assert _scripts() == [script for script, (_, lane, stage) in EXPECTED.items()
+                          if settings[lane] and settings[stage]]
+
+
+@pytest.mark.parametrize("settings, scripts", LAYOUTS, ids=LAYOUT_IDS)
+def test_the_three_instance_layout(monkeypatch, settings, scripts):
+    _set(monkeypatch, settings)
+    assert consumer_roles.validate() == []
+    assert _scripts() == scripts
+
+
+def test_the_three_instances_together_run_every_consumer_once(monkeypatch):
+    """No consumer is left out, and none runs on two kinds of instance -- where
+    both would share its partitions, whatever each was deployed to do."""
+    started = []
+    for settings, _ in LAYOUTS:
+        _set(monkeypatch, settings)
+        started.extend(_scripts())
+    assert sorted(started) == sorted(EXPECTED)
+
+
+@pytest.mark.parametrize("consumer", consumer_roles.CONSUMERS, ids=lambda c: c.name)
+def test_each_consumer_is_the_script_that_plays_its_role(consumer):
+    """A consumer's lane and stage are only as good as the script it names:
+    the role that script sets is what picks its topic and its route."""
+    role, lane_switch, stage_switch = EXPECTED[consumer.script]
+    assert consumer.role == role
+    assert consumer_roles.LANES[consumer.lane][0] == lane_switch
+    assert consumer_roles.STAGES[consumer.stage][0] == stage_switch
+    source = (REPO / consumer.script).read_text(encoding="utf-8")
+    assert f'os.environ["CONSUMER_ROLE"] = "{role}"' in source
+
+
+# ======================================================================
+# Reading the switches
+# ======================================================================
+
+@pytest.mark.parametrize("raw, on", [
+    ("true", True), ("TRUE", True), (" yes ", True), ("1", True),
+    ("false", False), ("False", False), ("no", False), ("0", False),
+])
+def test_switch_spellings(monkeypatch, raw, on):
+    monkeypatch.setenv("DLT_ENABLED", raw)
+    assert (consumer_roles.DLT in consumer_roles.lanes()) is on
+
+
+def test_a_blank_switch_is_its_default(monkeypatch):
+    for name in SWITCHES:
+        monkeypatch.setenv(name, "  ")
+    assert _scripts() == ["src/fast_consumer.py", "src/slow_consumer.py"]
+    assert consumer_roles.validate() == []
+
+
+def test_a_misspelt_switch_is_refused_rather_than_guessed(monkeypatch):
+    monkeypatch.setenv("REJECTION_ENABLED", "ture")
+    assert consumer_roles.validate() == [
+        "REJECTION_ENABLED must be true or false; got 'ture'."]
+    with pytest.raises(ValueError):
+        consumer_roles.selected()
+
+
+def test_every_misspelt_switch_is_reported_at_once(monkeypatch):
+    monkeypatch.setenv("DLT_ENABLED", "enabled")
+    monkeypatch.setenv("FETCH_STAGE_ENABLED", "off")
+    assert consumer_roles.validate() == [
+        "DLT_ENABLED must be true or false; got 'enabled'.",
+        "FETCH_STAGE_ENABLED must be true or false; got 'off'.",
+    ]
+
+
+# ======================================================================
+# Configurations refused
+# ======================================================================
+
+@pytest.mark.parametrize("settings", [
+    # The likeliest slip: a DLT analysis instance that turns the rejection
+    # lane off and forgets that DLT_ENABLED is off by default.
+    {"REJECTION_ENABLED": "false", "FETCH_STAGE_ENABLED": "false"},
+    {"REJECTION_ENABLED": "false", "DLT_ENABLED": "false"},
+    {"FETCH_STAGE_ENABLED": "false", "ANALYSIS_STAGE_ENABLED": "false"},
+    {"DLT_ENABLED": "true", "FETCH_STAGE_ENABLED": "false",
+     "ANALYSIS_STAGE_ENABLED": "false"},
+], ids=["dlt-left-at-default", "no-lane", "no-stage", "lanes-but-no-stage"])
+def test_an_instance_that_would_run_no_consumer_is_refused(monkeypatch, settings):
+    _set(monkeypatch, settings)
+    errors = consumer_roles.validate()
+    assert len(errors) == 1
+    assert errors[0].startswith("No Kafka consumer is switched on")
+
+
+@pytest.mark.parametrize("settings, lanes", [
+    (FETCH_INSTANCE, ["The rejection lane's fetch stage", "The DLT lane's fetch stage"]),
+    (REJECTION_ANALYSIS_INSTANCE, ["The rejection lane's analysis stage"]),
+    (DLT_ANALYSIS_INSTANCE, ["The DLT lane's analysis stage"]),
+], ids=LAYOUT_IDS)
+def test_a_lane_split_across_instances_needs_s3(monkeypatch, settings, lanes):
+    """The analysis instance reads what the fetch instance saved, and on local
+    storage each instance has only its own disk."""
+    _set(monkeypatch, settings, storage="local")
+    errors = consumer_roles.validate()
+    assert [error.split(" runs here")[0] for error in errors] == lanes
+    assert all(error.endswith("needs CASEBOOK_STORAGE_BACKEND=s3, not 'local'.")
+               for error in errors)
+
+
+def test_a_split_lane_is_refused_on_any_backend_but_s3(monkeypatch):
+    _set(monkeypatch, REJECTION_ANALYSIS_INSTANCE, storage="minio")
+    assert consumer_roles.validate()[0].endswith("not 'minio'.")
+
+
+@pytest.mark.parametrize("settings", [
+    {},
+    {"DLT_ENABLED": "true"},
+    {"REJECTION_ENABLED": "false", "DLT_ENABLED": "true"},
+], ids=["default", "both-lanes", "dlt-lane-alone"])
+def test_a_lane_whose_stages_both_run_here_needs_no_shared_storage(monkeypatch, settings):
+    """Nothing passes between the two lanes, so only a lane split by stage
+    needs S3."""
+    _set(monkeypatch, settings, storage="local")
+    assert consumer_roles.validate() == []
+
+
+def test_env_example_lists_every_switch_at_its_default():
+    lines = set((REPO / ".env.example").read_text(encoding="utf-8").splitlines())
+    for variable, default in (*consumer_roles.LANES.values(),
+                              *consumer_roles.STAGES.values()):
+        assert f"{variable}={'true' if default else 'false'}" in lines
+
+
+# ======================================================================
+# start.py
+# ======================================================================
+
+class _Child:
+    """A child process that runs until it is stopped, or made to exit."""
+
+    def __init__(self, args):
+        self.script = args[1]
+        self.returncode = None
+        self.terminated = False
+
+    def poll(self):
+        return self.returncode
+
+    def terminate(self):
+        self.terminated = True
+        self.returncode = -15
+
+    def kill(self):
+        self.returncode = -9
+
+    def wait(self, timeout=None):
+        return self.returncode
+
+
+API_EXITS = "api exits"
+
+
+@pytest.fixture
+def supervisor(monkeypatch):
+    """Run `start.main()` to the end; returns what it did.
+
+    `ready` is what /ready answers, in turn, the last answer repeating; the
+    marker API_EXITS makes the API exit at that probe instead. Once anything
+    beyond the API is running, the next sleep -- the loop watching the
+    children -- makes the `exits` child exit with its code, which ends the run.
+    """
+    import start
+
+    def run_supervisor(ready=((200, '{"status":"ready"}'),), api_exit=None,
+                       exits=("src/main_api.py", 0)):
+        run = SimpleNamespace(events=[], children=[], sleeps=0, code=None)
+        answers = list(ready)
+
+        def popen(args):
+            child = _Child(args)
+            if not run.children:
+                child.returncode = api_exit
+            run.children.append(child)
+            run.events.append(child.script)
+            return child
+
+        def http_get(path):
+            run.events.append(f"GET {path}")
+            if path != "/ready":
+                return 200, '{"status":"up"}'
+            answer = answers.pop(0) if len(answers) > 1 else answers[0]
+            if answer == API_EXITS:
+                run.children[0].returncode = 2
+                return None, "Connection refused"
+            return answer
+
+        def sleep(_seconds):
+            run.sleeps += 1
+            assert run.sleeps < 1000, "the supervisor never stopped"
+            if len(run.children) > 1:
+                script, code = exits
+                next(c for c in run.children if c.script == script).returncode = code
+
+        monkeypatch.setattr(start, "subprocess", SimpleNamespace(
+            Popen=popen, TimeoutExpired=subprocess.TimeoutExpired))
+        monkeypatch.setattr(start, "time", SimpleNamespace(
+            sleep=sleep, monotonic=time.monotonic))
+        monkeypatch.setattr(start, "signal", SimpleNamespace(
+            signal=lambda *args: None, SIGTERM=signal.SIGTERM, SIGINT=signal.SIGINT))
+        monkeypatch.setattr(start, "_http_get", http_get)
+        monkeypatch.setattr(start, "_children", [])
+        monkeypatch.setattr(start, "_stopping", False)
+
+        with pytest.raises(SystemExit) as stopped:
+            start.main()
+        run.code = stopped.value.code
+        run.started = [event for event in run.events if not event.startswith("GET ")]
+        return run
+
+    return run_supervisor
+
+
+def test_the_supervisor_starts_what_it_always_started(supervisor):
+    run = supervisor()
+    assert run.started == ["src/main_api.py", "src/fast_consumer.py",
+                           "src/slow_consumer.py"]
+    assert run.code == 0
+
