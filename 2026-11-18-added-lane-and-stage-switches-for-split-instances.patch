+def test_the_supervisor_waits_for_the_downloads_without_a_tool_server_of_its_own(
+        monkeypatch, supervisor):
+    """It waited on /ready only when the API served its own tools, so an
+    instance without them -- a fetch instance with AGENT_MCP_SERVE=false --
+    forwarded packets before the service map had arrived, and the fetch stage
+    saves the service it resolves for the analysis stage to reuse."""
+    _set(monkeypatch, FETCH_INSTANCE)
+    monkeypatch.setenv("AGENT_MCP_SERVE", "false")
+    downloading = (503, '{"detail":"Downloading reason-code service map"}')
+    run = supervisor(ready=[downloading, downloading, (200, '{"status":"ready"}')])
+    assert run.events == ["src/main_api.py", "GET /health",
+                          "GET /ready", "GET /ready", "GET /ready",
+                          "src/fast_consumer.py", "src/dlt_consumer.py"]
+
+
