index 0000000..28362b7
--- /dev/null
+++ b/src/utils/consumer_roles.py
@@ -0,0 +1,156 @@
+"""Which Kafka consumers this instance runs.
+
+Both lanes split into the same two stages, and each stage of each lane is a
+consumer process of its own (ARCHITECTURE.md 3.11, 4.4):
+
+    lane        fetch stage                          analysis stage
+    rejection   fast_consumer.py -> /fetch-logs      slow_consumer.py -> /analyze-rejection
+    DLT         dlt_consumer.py -> /fetch-dlt-logs   dlt_analysis_consumer.py -> /analyze-dlt
+
+start.py runs the API beside whichever of them four switches select:
+
+    REJECTION_ENABLED       (true)   the rejection lane
+    DLT_ENABLED             (false)  the DLT lane
+    FETCH_STAGE_ENABLED     (true)   the fetch stage of each lane that is on
+    ANALYSIS_STAGE_ENABLED  (true)   the analysis stage of each lane that is on
+
+Left unset they start what start.py always started: the two rejection
+consumers, and the two DLT consumers as well under DLT_ENABLED=true. Set
+apart, they let one image run as separate deployments, each sized for its own
+work: one fetching both lanes' logs, one analysing rejections, one analysing
+dead letters.
+
+Only start.py reads them. A consumer takes its role from its own entry
+script, and the API serves every route whatever runs beside it.
+"""
+import os
+from typing import NamedTuple
+
+REJECTION = "rejection"
+DLT = "dlt"
+FETCH = "fetch"
+ANALYSIS = "analysis"
+
+#: Each lane's switch and its default. DLT_ENABLED keeps the default it has
+#: always had: a deployment with no dead-letter topic would otherwise start
+#: consumers that fail to subscribe, and the supervisor tears everything down
+#: when one exits (DLT_PLAN.md Phase 4).
+LANES = {
+    REJECTION: ("REJECTION_ENABLED", True),
+    DLT: ("DLT_ENABLED", False),
+}
+
+#: Each stage's switch and its default.
+STAGES = {
+    FETCH: ("FETCH_STAGE_ENABLED", True),
+    ANALYSIS: ("ANALYSIS_STAGE_ENABLED", True),
+}
+
+#: How a lane is named in what start.py prints.
+LANE_LABELS = {REJECTION: "rejection", DLT: "DLT"}
+
+_TRUE = ("true", "1", "yes")
+_FALSE = ("false", "0", "no")
+
+
+class Consumer(NamedTuple):
+    name: str     # the supervisor's name for the process
+    title: str    # how start.py announces it
+    role: str     # the CONSUMER_ROLE its entry script sets
+    lane: str
+    stage: str
+    script: str
+    flow: str     # what it reads -> where it forwards it
+
+
+#: Every consumer, in the order start.py starts them.
+CONSUMERS = (
+    Consumer("FastConsumer", "the fast consumer", "fast", REJECTION, FETCH,
+             "src/fast_consumer.py", "rejections -> /fetch-logs"),
+    Consumer("SlowConsumer", "the slow consumer", "slow", REJECTION, ANALYSIS,
+             "src/slow_consumer.py", "analysis queue -> /analyze-rejection"),
+    Consumer("DltConsumer", "the DLT consumer", "dlt", DLT, FETCH,
+             "src/dlt_consumer.py", "dead-letter topics -> /fetch-dlt-logs"),
+    Consumer("DltAnalysisConsumer", "the DLT analysis consumer", "dlt_analysis", DLT,
+             ANALYSIS, "src/dlt_analysis_consumer.py", "DLT queue -> /analyze-dlt"),
+)
+
+
+def _switch(variable: str, default: bool) -> bool:
+    """A switch's value; unset or blank is its default.
+
+    Anything that is neither true nor false is an error rather than a guess.
+    Read as off, a misspelt switch leaves a lane's packets unread; read as on,
+    it starts consumers that take a share of the partitions another instance
+    was deployed to read.
+    """
+    raw = os.environ.get(variable, "").strip()
+    if not raw:
+        return default
+    if raw.lower() in _TRUE:
+        return True
+    if raw.lower() in _FALSE:
+        return False
+    raise ValueError(f"{variable} must be true or false; got {raw!r}.")
+
+
+def lanes() -> tuple:
+    """The lanes switched on. Raises ValueError on a misspelt switch."""
+    return tuple(lane for lane, (variable, default) in LANES.items()
+                 if _switch(variable, default))
+
+
+def stages() -> tuple:
+    """The stages switched on. Raises ValueError on a misspelt switch."""
+    return tuple(stage for stage, (variable, default) in STAGES.items()
+                 if _switch(variable, default))
+
+
+def selected() -> tuple:
+    """The consumers to start here, in the order to start them."""
+    on_lanes, on_stages = lanes(), stages()
+    return tuple(consumer for consumer in CONSUMERS
+                 if consumer.lane in on_lanes and consumer.stage in on_stages)
+
+
+def validate() -> list:
+    """Configuration errors, for start.py to refuse to start on."""
+    errors = []
+    for variable, default in (*LANES.values(), *STAGES.values()):
+        try:
+            _switch(variable, default)
+        except ValueError as error:
+            errors.append(str(error))
+    if errors:
+        return errors
+
+    consumers = selected()
+    if not consumers:
+        return ["No Kafka consumer is switched on: REJECTION_ENABLED and DLT_ENABLED "
+                "choose the lanes and FETCH_STAGE_ENABLED and ANALYSIS_STAGE_ENABLED "
+                "their stages, and at least one of each must be true."]
+
+    # A lane run here at one stage only has its other stage on another
+    # instance, and the two hand every packet over through the casebook store:
+    # the fetch stage saves the logs, the status and the service that the
