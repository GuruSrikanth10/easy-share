+# What is redacted: every name in this list, and nothing else.
+#
+# Each name is a JSON key: the value of "<name>": ... is redacted wherever it
+# is logged, whatever it is -- a string, number, object or array -- at any
+# depth, in plain or escaped JSON. Order does not matter, and names match
+# case-insensitively. null, true, false and "" are left as they are.
+#
+# Four names also have a shape the code recognises, and are redacted by that
+# shape anywhere in the text, under a key or not:
+#   aadhaar   12 digits, or 1234 5678 9012 / 1234-5678-9012
+#   vid       16 digits
+#   mobile    10 digits starting with 6-9
+#   email     an email address
+#
+# Every path that redacts applies the list: logs from every source, before
+# anything is persisted; the DLT lane's evidence and prompt; the database
+# tools' results; and the Langfuse trace export (K8S_REDACT_ENABLED=false
+# turns it off for logs only). A redacted value becomes a [REDACTED:...]
+# placeholder, so a reader can still see that one was there.
+#
+# The identifiers a packet is searched and traced by -- its eventId, refId
+# and the like -- are kept even where a name below would match them.
+#
+# After a change, run `python -m src.tools.redaction_audit` over a service's
+# sample logs: what it reports must be zero.
+redact = [
+    # Identity numbers and contact details.
+    "aadhaar", "vid", "mobile", "email", "uid",
+    # The resident's name, in any script.
+    "name", "fullName", "firstName", "middleName", "lastName", "residentName",
+    "localName", "nameLocal",
+    # Relatives' names.
+    "fatherName", "motherName", "spouseName", "husbandName", "guardianName",
+    "parentName", "relativeName", "careOf",
+    # Birth and gender.
+    "dob", "dateOfBirth", "yearOfBirth", "gender",
+    # The address.
+    "address", "addressLine1", "addressLine2", "addressLine3", "house",
+    "houseNumber", "street", "landmark", "locality", "vtc", "village",
+    "subDistrict", "district", "city", "postOffice", "pincode", "postalCode",
+]
