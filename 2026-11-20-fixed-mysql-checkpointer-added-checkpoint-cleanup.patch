index 0000000..bdab66e
--- /dev/null
+++ b/src/core/mysql_saver.py
@@ -0,0 +1,65 @@
+"""
+The MySQL checkpointer (CHECKPOINT_BACKEND=mysql): `PyMySQLSaver` on a
+connection that is replaced when MySQL has closed it.
+
+`PyMySQLSaver` keeps one pymysql connection for the life of the process and
+never reconnects. MySQL closes a connection left idle longer than its
+`wait_timeout`, and a MySQL restart or a firewall can close it sooner. Every
+later query then failed -- "Lost connection to MySQL server during query",
+then `InterfaceError: (0, '')` -- so every packet failed until the pod
+restarted, while /ready kept passing (seen against MySQL 8.4 on 2026-11-20).
+
+So each query first pings the connection under the saver's own lock, and one
+that does not answer is replaced. pymysql's `ping(reconnect=True)` did the
+same, but pymysql 1.2 deprecates it.
+
+Imported only by `checkpointer._build_mysql`, so a sqlite or postgres
+deployment never loads langgraph-checkpoint-mysql.
+"""
+from contextlib import contextmanager
+
+import pymysql
+from langgraph.checkpoint.mysql.pymysql import PyMySQLSaver
+
+
+class ReconnectingPyMySQLSaver(PyMySQLSaver):
+    """`PyMySQLSaver` that reconnects when MySQL has closed its connection."""
+
+    def __init__(self, uri: str):
+        self._connect_kwargs = PyMySQLSaver.parse_conn_string(uri)
+        super().__init__(self._connect())
+
+    def _connect(self) -> pymysql.Connection:
+        # autocommit as `from_conn_string` sets it: `setup()` and every query
+        # outside a pipeline rely on it.
+        return pymysql.connect(**self._connect_kwargs, autocommit=True)
+
+    @contextmanager
+    def _cursor(self, *, pipeline: bool = False):
+        # The base class reads `self.conn` here and nowhere else, so a
+        # connection replaced before this runs is the one every query uses.
+        with self.lock:
+            self._reconnect_if_closed()
+        with super()._cursor(pipeline=pipeline) as cur:
+            yield cur
+
+    def _reconnect_if_closed(self) -> None:
+        """Replace the connection if it no longer answers. The caller holds
+        `self.lock`, so no query is using it meanwhile."""
+        try:
+            self.conn.ping()
+            return
+        except (pymysql.err.Error, OSError):
+            pass
+        try:
+            self.conn.close()
+        except (pymysql.err.Error, OSError):
+            pass  # Already closed, which is why it is being replaced.
+        self.conn = self._connect()
+
+    def ping(self) -> None:
+        """Run a query, reconnecting first if MySQL closed the connection.
+        Raises when MySQL cannot be reached. For /ready
+        (`checkpointer.health_check`)."""
+        with self._cursor() as cur:
+            cur.execute("SELECT 1")
