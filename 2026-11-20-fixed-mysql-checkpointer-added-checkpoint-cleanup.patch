+def _discard_checkpoints(agent, event_id: str) -> None:
+    """Delete the packet's checkpoints once its run is over. Never raises.
+
+    Nothing reads a finished run's checkpoints: a redelivery of a terminal
+    packet is skipped, and a packet run again starts on an emptied thread
+    (`invoke_fresh`). They were kept all the same, and the SQLite file in the
+    pod's writable layer grew 0.9-3.2 MiB a packet until the pod was evicted
