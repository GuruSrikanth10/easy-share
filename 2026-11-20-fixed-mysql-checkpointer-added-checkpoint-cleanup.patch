diff --git a/tests/test_checkpoint_cleanup.py b/tests/test_checkpoint_cleanup.py
new file mode 100644
index 0000000..b21adfb
--- /dev/null
+++ b/tests/test_checkpoint_cleanup.py
@@ -0,0 +1,136 @@
+"""
+A packet's checkpoints are deleted once it is terminal (routes._discard_checkpoints).
+
+Nothing read a finished run's checkpoints, and nothing deleted them: the
+SQLite file in the pod's writable layer grew 0.9-3.2 MiB a packet until pods
+were evicted for ephemeral storage (2026-11-20). They go after the casebook is
+saved, on the DLQ path, when a late result is discarded, and for a run past
+its budget once it has stopped. A packet the API shut down on keeps them for
+its redelivery (FAILED_SHUTDOWN), which the drain path never deletes.
+"""
+import concurrent.futures
+import json
+import threading
+import time
+from unittest.mock import MagicMock, patch
+
+import src.api.routes as routes
+import src.core.agent_orchestrator as orch
+from src.core import checkpointer, run_control
+from src.models.unified_casebook import rejection_short_record, save_casebook
+from test_end_to_end import _run, _stub_llm, storage  # noqa: F401  (storage: a fixture)
+
+SYNTHESIS = json.dumps({
+    "rejection_description": "manual dedup rejected the packet",
+    "synthesis": "ask the resident to resubmit",
+    "action": "RESIDENT_PACKET_RESUBMIT",
+    "resident_action": "NEW_PACKET",
+    "confidence": 0.9,
+})
+
+
+def _rows(saver, thread_id) -> int:
+    return sum(saver.conn.execute(f"SELECT count(*) FROM {table} WHERE thread_id = ?",
+                                  (thread_id,)).fetchone()[0]
+               for table in ("checkpoints", "writes"))
+
+
+def _graph_stub(**behaviour):
+    """The whole graph, mocked: `get_state` finds nothing to resume."""
+    agent = MagicMock()
+    agent.get_state.return_value = None
+    for name, value in behaviour.items():
+        setattr(agent.invoke, name, value)
+    return agent
+
+
+def test_a_processed_packets_checkpoints_are_deleted(storage, monkeypatch):  # noqa: F811
+    """Through the real graph and SQLite saver: the run checkpointed, and
+    nothing of it is left once the casebook is saved."""
+    saver = checkpointer.get_checkpointer()
+    left_at_delete = []
+    real_delete = saver.delete_thread
+
+    def delete(thread_id):
+        left_at_delete.append(_rows(saver, thread_id))
+        real_delete(thread_id)
+
+    monkeypatch.setattr(saver, "delete_thread", delete)
+    monkeypatch.setattr(orch, "is_reviewer_approved", lambda _f: True)
+    with patch.object(orch, "build_agent", side_effect=lambda *a, **k: _stub_llm(SYNTHESIS)), \
+            patch.object(orch, "get_llm", side_effect=lambda tier: MagicMock()):
+        assert _run("cleanup-processed")["status"] == "processed"
+
+    assert storage.terminal_status("cleanup-processed")
+    assert left_at_delete and left_at_delete[0] > 0
+    assert _rows(saver, "cleanup-processed") == 0
+
+
+def test_a_dead_lettered_packets_checkpoints_are_deleted(storage):  # noqa: F811
+    agent = _graph_stub(side_effect=RuntimeError("the graph failed"))
+    with patch("src.api.routes.get_agent", return_value=agent), \
+            patch("src.api.routes.publish_to_dlq"):
+        assert _run("cleanup-dlq")["status"] == "dlq"
+
+    agent.checkpointer.delete_thread.assert_called_once_with("cleanup-dlq")
+
+
+def test_a_discarded_late_results_checkpoints_are_deleted(storage):  # noqa: F811
+    def invoke(*args, **kwargs):
+        # The consumer gave up on this run and recorded its own verdict meanwhile.
+        save_casebook(storage, "cleanup-late",
+                      rejection_short_record("cleanup-late", "FAILED_TIMEOUT", "gave up"))
+        return {"synthesis": SYNTHESIS}
+
+    agent = _graph_stub(side_effect=invoke)
+    with patch("src.api.routes.get_agent", return_value=agent):
+        assert _run("cleanup-late")["status"] == "already_processed"
+
+    agent.checkpointer.delete_thread.assert_called_once_with("cleanup-late")
+
+
+def test_a_timed_out_runs_checkpoints_are_deleted_once_it_has_stopped(storage, monkeypatch):  # noqa: F811
+    """The run goes on writing checkpoints until its next step, so they are
+    deleted when it stops, not when the route stops waiting."""
+    monkeypatch.setenv("AGENT_INVOKE_TIMEOUT_SECONDS", "0.1")
+    stopped = threading.Event()
+    deleted = threading.Event()
+
+    def slow_invoke(*args, **kwargs):
+        deadline = time.monotonic() + 5
+        while time.monotonic() < deadline and not run_control.cancelled():
+            time.sleep(0.01)
+        stopped.set()
+        run_control.check()
+
+    agent = _graph_stub(side_effect=slow_invoke)
+    deleted_after_stop = []
+    agent.checkpointer.delete_thread.side_effect = (
+        lambda thread_id: (deleted_after_stop.append(stopped.is_set()), deleted.set()))
+    with patch("src.api.routes.get_agent", return_value=agent), \
+            patch("src.api.routes.publish_to_dlq"):
+        assert _run("cleanup-timeout")["status"] == "failed_timeout"
+
+    assert deleted.wait(5)
+    agent.checkpointer.delete_thread.assert_called_once_with("cleanup-timeout")
+    assert deleted_after_stop == [True]
+
+
+def test_a_run_that_never_started_deletes_nothing():
+    """Its done-callback runs on the event loop, and it wrote nothing."""
+    run = concurrent.futures.Future()
+    run.cancel()
+    agent = MagicMock()
+
+    routes._discard_abandoned_checkpoints(agent, "never-started", run)
+
+    agent.checkpointer.delete_thread.assert_not_called()
+
+
+def test_a_failed_delete_does_not_fail_the_packet(storage):  # noqa: F811
+    agent = _graph_stub(return_value={"synthesis": SYNTHESIS})
+    agent.checkpointer.delete_thread.side_effect = RuntimeError("MySQL went away")
+    with patch("src.api.routes.get_agent", return_value=agent):
+        assert _run("cleanup-delete-fails")["status"] == "processed"
+
+    assert storage.terminal_status("cleanup-delete-fails")
diff --git a/tests/test_mysql_checkpointer.py b/tests/test_mysql_checkpointer.py
new file mode 100644
index 0000000..b107866
--- /dev/null
+++ b/tests/test_mysql_checkpointer.py
@@ -0,0 +1,235 @@
+"""
+CHECKPOINT_BACKEND=mysql (core/checkpointer.py, core/mysql_saver.py).
+
+Two defects, found against MySQL 8.4 on 2026-11-20, kept this backend from
+ever working:
+
+- `_build_mysql` entered the context manager `PyMySQLSaver.from_conn_string`
+  returns and kept only the saver. The context manager was collected at once,
+  which closed the connection, so `setup()` failed with
+  `InterfaceError: (0, '')`. `_build_postgres` did the same.
+- The saver keeps one connection and never reconnected. Once MySQL closed it
+  (idle past `wait_timeout`, a restart), every packet failed, while
+  `health_check` kept reporting it healthy.
+
+The unit tests stand in a fake connection for pymysql's. The last test runs
+against a real MySQL when CHECKPOINT_TEST_MYSQL_URI names a database it may
+create tables in, e.g. one from `docker run -p 127.0.0.1:3307:3306 mysql:8.4`.
+"""
+import gc
+import os
+import sys
+import time
+import types
+from contextlib import contextmanager
+
+import pymysql
+import pytest
+from langchain_core.messages import AIMessage, HumanMessage
+from langgraph.graph import START, MessagesState, StateGraph
+
+from src.core import checkpointer
+from src.core.mysql_saver import ReconnectingPyMySQLSaver
+
+URI = "mysql://su01:secret@db.example:3306/agentic_crm"
+
+#: A real MySQL database the last test may create tables in; unset, it skips.
+REAL_MYSQL_URI = os.environ.get("CHECKPOINT_TEST_MYSQL_URI", "")
+
+
+class FakeCursor:
+    def __init__(self, conn):
+        self.conn = conn
+
+    def __enter__(self):
+        return self
+
+    def __exit__(self, *exc):
+        return False
+
+    def execute(self, sql, args=None):
+        if self.conn.lost:
+            raise pymysql.err.OperationalError(2013, "Lost connection to MySQL server during query")
+        self.conn.queries.append(" ".join(sql.split()))
+
+    def fetchone(self):
+        return None
+
+    def fetchall(self):
+        return []
+
+
+class FakeConnection:
+    """pymysql's connection, as far as the saver and the ping use it."""
+
+    def __init__(self, kwargs):
+        self.kwargs = kwargs
+        self.queries = []
+        self.lost = False
+        self.closed = False
+
+    def cursor(self, *args):
+        return FakeCursor(self)
+
+    def ping(self, reconnect=False):
+        if self.lost or self.closed:
+            raise pymysql.err.OperationalError(2013, "Lost connection to MySQL server during query")
+        self.queries.append("PING")
+
+    def close(self):
+        if self.closed:
+            raise pymysql.err.Error("Already closed")
+        self.closed = True
+
+    def begin(self):
+        pass
+
+    def commit(self):
+        pass
+
+    def rollback(self):
+        pass
+
+
+@pytest.fixture
+def mysql(monkeypatch):
+    """CHECKPOINT_BACKEND=mysql on fake connections; yields the list of them,
+    in the order they were opened."""
+    connections = []
+
+    def connect(**kwargs):
+        connection = FakeConnection(kwargs)
+        connections.append(connection)
+        return connection
+
+    monkeypatch.setattr(pymysql, "connect", connect)
+    monkeypatch.setenv("CHECKPOINT_BACKEND", "mysql")
+    monkeypatch.setenv("CHECKPOINT_MYSQL_URI", URI)
+    checkpointer.reset_checkpointer()
+    yield connections
+    checkpointer.reset_checkpointer()
+
+
+def test_the_mysql_checkpointer_keeps_its_connection_and_sets_up(mysql):
+    saver = checkpointer.get_checkpointer()
+    gc.collect()
+
+    assert isinstance(saver, ReconnectingPyMySQLSaver)
+    (connection,) = mysql
+    assert not connection.closed, "the builder must not close the connection it gave the saver"
+    assert connection.kwargs == {"host": "db.example", "port": 3306, "user": "su01",
+                                 "password": "secret", "database": "agentic_crm",
+                                 "unix_socket": None, "autocommit": True}
+    created = [q for q in connection.queries if q.startswith("CREATE TABLE IF NOT EXISTS")]
+    assert {q.split()[5] for q in created} == {"checkpoint_migrations", "checkpoints",
+                                               "checkpoint_blobs", "checkpoint_writes"}
+
+
+def test_a_live_connection_is_kept(mysql):
+    saver = checkpointer.get_checkpointer()
+    saver.delete_thread("evt-1")
+    assert checkpointer.health_check() is True
+
+    assert len(mysql) == 1
+    assert mysql[0].queries[-1] == "SELECT 1"
+
+
+def test_a_connection_mysql_closed_is_replaced_before_the_next_query(mysql):
+    saver = checkpointer.get_checkpointer()
+    mysql[0].lost = True
+
+    saver.delete_thread("evt-1")  # a transaction (pipeline=True)
+
+    first, second = mysql
+    assert first.closed
+    assert saver.conn is second
+    assert any(q.startswith("DELETE FROM checkpoints WHERE thread_id") for q in second.queries)
+
+
+def test_health_check_queries_mysql_and_reconnects(mysql):
+    """/ready used to pass on a saver whose connection MySQL had closed."""
+    checkpointer.get_checkpointer()
+    mysql[0].lost = True
+
+    assert checkpointer.health_check() is True
+    assert mysql[1].queries[-1] == "SELECT 1"
+
+
+def test_health_check_fails_while_mysql_is_unreachable(mysql, monkeypatch):
+    checkpointer.get_checkpointer()
+    mysql[0].lost = True
+
+    def refuse(**kwargs):
+        raise pymysql.err.OperationalError(2003, "Can't connect to MySQL server")
+
+    monkeypatch.setattr(pymysql, "connect", refuse)
+    with pytest.raises(pymysql.err.OperationalError):
+        checkpointer.health_check()
+
+
+def test_the_postgres_checkpointer_keeps_its_connection_open(monkeypatch):
+    """The same dropped context manager, on the postgres builder."""
+
+    class FakePostgresSaver:
+        def __init__(self, conn):
+            self.conn = conn
+
+        @classmethod
+        @contextmanager
+        def from_conn_string(cls, uri):
+            conn = types.SimpleNamespace(closed=False)
+            try:
+                yield cls(conn)
+            finally:
+                conn.closed = True
+
+        def setup(self):
+            assert not self.conn.closed, "setup() ran on a closed connection"
+
+    module = types.ModuleType("langgraph.checkpoint.postgres")
+    module.PostgresSaver = FakePostgresSaver
+    monkeypatch.setitem(sys.modules, "langgraph.checkpoint.postgres", module)
+    monkeypatch.setenv("CHECKPOINT_BACKEND", "postgres")
+    monkeypatch.setenv("CHECKPOINT_POSTGRES_URI", "postgresql://u:p@db.example/checkpoints")
+    checkpointer.reset_checkpointer()
+    try:
+        saver = checkpointer.get_checkpointer()
+        gc.collect()
+        assert saver.conn.closed is False
+    finally:
+        checkpointer.reset_checkpointer()
+
+
+def _graph(saver):
+    builder = StateGraph(MessagesState)
+    builder.add_node("answer", lambda state: {"messages": [AIMessage(content="ok")]})
+    builder.add_edge(START, "answer")
+    return builder.compile(checkpointer=saver)
+
+
+@pytest.mark.skipif(not REAL_MYSQL_URI,
+                    reason="set CHECKPOINT_TEST_MYSQL_URI to a MySQL database it may write to")
+def test_against_a_real_mysql(monkeypatch):
+    monkeypatch.setenv("CHECKPOINT_BACKEND", "mysql")
+    monkeypatch.setenv("CHECKPOINT_MYSQL_URI", REAL_MYSQL_URI)
+    checkpointer.reset_checkpointer()
+    try:
+        saver = checkpointer.get_checkpointer()
+        graph = _graph(saver)
+
+        def run(thread):
+            config = {"configurable": {"thread_id": thread}}
+            graph.invoke({"messages": [HumanMessage(content="hi")]}, config)
+            assert len(graph.get_state(config).values["messages"]) == 2
+            saver.delete_thread(thread)
+            assert saver.get_tuple(config) is None
+
+        run("checkpointer-test-1")
+        # MySQL closes the connection once it has been idle past wait_timeout.
+        with saver.conn.cursor() as cur:
+            cur.execute("SET SESSION wait_timeout = 1")
+        time.sleep(2)
+        assert checkpointer.health_check() is True
+        run("checkpointer-test-2")
+    finally:
+        checkpointer.reset_checkpointer()
