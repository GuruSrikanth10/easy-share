@@ -428,6 +428,99 @@ def test_the_fetch_stage_counts_a_request_that_failed(fetch_stage, monkeypatch):
     assert dict(labels)["service"] != "unknown", "it failed after its service was resolved"
 
 
+# ======================================================================
+# The rejection lane's intake, by status
+# ======================================================================
+
+AUDIT = ROOT / "tests" / "fixtures" / "audit"
+# Where _packet's reason code places it.
+SERVICE = "enu-biometric"
+
+
+def _received(act) -> tuple:
+    """The rejections and the ON_HOLD records `act()` counted."""
+    rejections = {}
+    on_hold = _increments(metrics.ON_HOLD_PACKETS_RECEIVED,
+                          lambda: rejections.update(
+                              _increments(metrics.REJECTION_PACKETS_RECEIVED, act)))
+    return rejections, on_hold
+
+
+def _rejection(service, outcome):
+    return (("outcome", outcome), ("service", service))
+
+
+@pytest.mark.parametrize("exists, outcome", [
+    (False, "dispatched"),
+    (True, "already_terminal"),
+    (OSError("storage unreachable"), "error"),
+])
+def test_a_rejection_is_counted_under_its_service_by_what_became_of_it(exists, outcome):
+    packet = json.dumps(_packet("evt-received")).encode("utf-8")
+
+    assert _received(lambda: _consume(packet, exists=exists)) == (
+        {_rejection(SERVICE, outcome): 1}, {})
+
+
+def test_an_on_hold_record_is_counted_apart_from_the_rejections():
+    packet = json.dumps(_packet("evt-held", "ON_HOLD")).encode("utf-8")
+
+    assert _received(lambda: _consume(packet)) == ({}, {(("service", SERVICE),): 1})
+
+
+@pytest.mark.parametrize("value", [
+    json.dumps(_packet("evt-other", "PROCESSED")).encode("utf-8"),
+    b"{not json",  # no status to count it by
+], ids=["not_rejected", "poison"])
+def test_a_message_neither_rejected_nor_on_hold_is_not_counted(value):
+    assert _received(lambda: _consume(value)) == ({}, {})
+
+
+@pytest.mark.parametrize("sample, rejections, on_hold", [
+    ("rejection_sample.json", 1, 0),
+    ("dlt_sample.json", 0, 1),
+])
+def test_the_audit_samples_are_counted_by_their_execution_status(sample, rejections, on_hold):
+    counted = _received(lambda: _consume((AUDIT / sample).read_bytes()))
+
+    assert tuple(sum(moved.values()) for moved in counted) == (rejections, on_hold)
+
+
+def test_a_rejection_is_counted_under_the_service_the_fetch_stage_gives_it(fetch_stage):
+    from src.api.routes import fetch_logs
+
+    packet = _packet("evt-same-service")
+    rejections, _ = _received(lambda: _consume(json.dumps(packet).encode("utf-8")))
+    fetched = _increments(metrics.FETCH_STAGE_PACKETS,
+                          lambda: fetch_logs(MessagePayload(**packet)))
+
+    assert {dict(labels)["service"] for labels in rejections} == \
+        {dict(labels)["service"] for labels in fetched} == {SERVICE}
+
+
+def test_the_slow_consumer_does_not_count_the_packets_again(monkeypatch):
+    import src.utils.kafkaConsumer as kc
+    from src.utils.message_adapters import for_role
+
+    monkeypatch.setattr(kc, "_adapter", for_role("slow"))
+    packet = json.dumps(_packet("evt-queued")).encode("utf-8")
+
+    assert _received(lambda: _consume(packet)) == ({}, {})
+
+
+def test_a_service_that_cannot_be_resolved_is_counted_as_unknown(monkeypatch):
+    from src.utils import service_registry
+
+    monkeypatch.setattr(service_registry, "resolve",
+                        MagicMock(side_effect=RuntimeError("registry unreadable")))
+    packet = json.dumps(_packet("evt-unplaced")).encode("utf-8")
+    pools = []
+
+    assert _received(lambda: pools.append(_consume(packet))) == (
+        {_rejection("unknown", "dispatched"): 1}, {})
+    pools[0].submit.assert_called_once()
+
+
