+# ======================================================================
+# The consumers
+# ======================================================================
+
+def _packet(event_id, status="REJECTED"):
+    return {
+        "eventId": event_id,
+        "sourceTopic": "ENU.BIO.PROCESS.COMPLETION.V2",
+        "flowMetaData": {"stage": "Biometric", "subStage": "MDD_POLICY_BATCH_1"},
+        "packetMetaData": {"refId": "REF-1", "srn": "SRN-1", "enrolmentType": "U",
+                           "pktSource": "REGISTRATION_CLIENT"},
+        "packetExecutionSummary": {
+            "packetStatus": status,
+            "errorData": [{"type": None, "errorReasonCode": "RESIDENT_MAN_DEDUP_REJECT_TD"}],
+        },
+    }
+
+
+def _consume(value: bytes, exists=False):
+    """Hand one message on the rejections topic to the fast consumer."""
+    import src.utils.kafkaConsumer as kc
+
+    msg = SimpleNamespace(value=value, offset=7, topic="rejections")
+    with patch.object(kc, "consumer", MagicMock()), \
+         patch.object(kc, "_worker_pool") as pool, \
+         patch.object(kc, "_offset_tracker", kc.OffsetTracker()), \
+         patch.object(kc, "_queue_semaphore", threading.Semaphore(1)), \
+         patch("src.utils.dlq_publisher.publish_to_dlq"), \
+         patch("src.storage.factory.get_casebook_storage") as storage:
+        if isinstance(exists, Exception):
+            storage.return_value.exists.side_effect = exists
+        else:
+            storage.return_value.exists.return_value = exists
+        kc._handle_one_message(MagicMock(), msg)
+    return pool
+
+
+def _consumed(outcome):
+    return _count(metrics.MESSAGES_CONSUMED, role="fast", topic="rejections", outcome=outcome)
+
+
+@pytest.mark.parametrize("status, exists, reason", [
+    ("PROCESSED", False, "not_rejected"),
+    ("ON_HOLD", False, "on_hold"),
+    ("REJECTED", True, "already_terminal"),
+])
+def test_a_skipped_message_is_counted_with_why(status, exists, reason):
+    consumed = _consumed("skipped")
+    skipped = _count(metrics.MESSAGES_SKIPPED, role="fast", reason=reason)
+
+    pool = _consume(json.dumps(_packet("evt-skip", status)).encode("utf-8"), exists=exists)
+
+    pool.submit.assert_not_called()
+    assert _consumed("skipped") == consumed + 1
+    assert _count(metrics.MESSAGES_SKIPPED, role="fast", reason=reason) == skipped + 1
+
+
+def test_a_dispatched_message_is_counted():
+    dispatched = _consumed("dispatched")
+
+    pool = _consume(json.dumps(_packet("evt-go")).encode("utf-8"))
+
+    pool.submit.assert_called_once()
+    assert _consumed("dispatched") == dispatched + 1
+
+
+def test_a_poison_pill_is_counted():
+    poison = _consumed("poison")
+    _consume(b"{not json")
+    assert _consumed("poison") == poison + 1
+
+
+def test_a_consumer_side_fault_is_counted_as_an_error():
+    errors = _consumed("error")
