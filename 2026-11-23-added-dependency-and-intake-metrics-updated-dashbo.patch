@@ -0,0 +1,586 @@
+"""Metrics for the external dependencies, the Kafka intake and each packet's
+log fetch -- and the directory that gets what the consumers count to the
+API's GET /metrics.
+
+Every consumer is a process of its own beside the API, and prometheus_client
+keeps a process's metrics in that process: before start.py shared a
+directory between them, a consumer's count reached no scrape at all.
+"""
+import json
+import os
+import subprocess
+import sys
+import threading
+from pathlib import Path
+from types import SimpleNamespace
+from unittest.mock import MagicMock, patch
+
+import pybreaker
+import pytest
+import requests
+
+from s3_fakes import FakeS3, S3Error, install
+from src.models.schemas import MessagePayload
+from src.utils import metrics
+
+ROOT = Path(__file__).resolve().parent.parent
+
+pytestmark = pytest.mark.skipif(not metrics.METRICS_AVAILABLE,
+                                reason="prometheus_client is an optional dependency")
+
+
+def _count(counter, **labels):
+    return counter.labels(**labels)._value.get()
+
+
+def _increments(counter, act) -> dict:
+    """{labels: increase} for every series of `counter` that `act()` moved."""
+    def samples():
+        return {tuple(sorted(sample.labels.items())): sample.value
+                for family in counter.collect() for sample in family.samples
+                if sample.name.endswith("_total")}
+
+    before = samples()
+    act()
+    after = samples()
+    return {labels: value - before.get(labels, 0)
+            for labels, value in after.items() if value != before.get(labels, 0)}
+
+
+# ======================================================================
+# The dependency recorder
+# ======================================================================
+
+def test_a_request_is_counted_with_the_bytes_it_moved():
+    sent = _count(metrics.DEPENDENCY_BYTES, dependency="t-ok", operation="upload")
+
+    def upload():
+        with metrics.dependency_request("t-ok", "upload") as request:
+            request["bytes"] = 42
+
+    assert _increments(metrics.DEPENDENCY_REQUESTS, upload) == {
+        (("dependency", "t-ok"), ("operation", "upload"), ("outcome", "ok")): 1}
+    assert _count(metrics.DEPENDENCY_BYTES, dependency="t-ok", operation="upload") == sent + 42
+
+
+def test_an_answer_is_not_an_error_and_still_raises():
+    def download():
+        with pytest.raises(KeyError):
+            with metrics.dependency_request("t-answer", "download",
+                                            classify=lambda error: "not_found"):
+                raise KeyError("absent")
+
+    requests_made = {}
+    errors = _increments(metrics.DEPENDENCY_ERRORS,
+                         lambda: requests_made.update(_increments(metrics.DEPENDENCY_REQUESTS, download)))
+
+    assert requests_made == {(("dependency", "t-answer"), ("operation", "download"),
+                              ("outcome", "not_found")): 1}
+    assert errors == {}
+
+
+def test_a_failure_is_counted_under_its_error_code():
+    def upload():
+        with pytest.raises(S3Error):
+            with metrics.dependency_request("t-fail", "upload"):
+                raise S3Error("SlowDown", 503)
+
+    requests_made = {}
+    errors = _increments(metrics.DEPENDENCY_ERRORS,
+                         lambda: requests_made.update(_increments(metrics.DEPENDENCY_REQUESTS, upload)))
+
+    assert requests_made == {(("dependency", "t-fail"), ("operation", "upload"),
+                              ("outcome", "error")): 1}
+    assert errors == {(("dependency", "t-fail"), ("error", "SlowDown"),
+                       ("operation", "upload")): 1}
+
+
+def test_a_metric_that_cannot_be_recorded_never_fails_the_request(monkeypatch):
+    """Under multiprocess mode a record is a file write, which can fail."""
+    class Unwritable:
+        def labels(self, **_labels):
+            raise OSError("the metrics directory is gone")
+
+    monkeypatch.setattr(metrics, "DEPENDENCY_REQUESTS", Unwritable())
+
+    with metrics.dependency_request("t-broken", "upload") as request:
+        request["bytes"] = 1
+    with pytest.raises(ValueError, match="the request's own"):
+        with metrics.dependency_request("t-broken", "upload"):
+            raise ValueError("the request's own")
+
+
+# ======================================================================
+# S3
+# ======================================================================
+
+def _s3(monkeypatch, fake=None):
+    from src.storage import s3 as s3_module
+
+    fake = fake or FakeS3()
+    install(monkeypatch, fake)
+    return s3_module.S3CasebookStorage(bucket="b", prefix="p")
+
+
+def _s3_count(operation, outcome):
+    return _count(metrics.DEPENDENCY_REQUESTS, dependency="s3", operation=operation,
+                  outcome=outcome)
+
+
+def test_s3_uploads_and_downloads_are_counted_with_their_bytes(monkeypatch):
+    store = _s3(monkeypatch)
+    uploads, downloads = _s3_count("upload", "ok"), _s3_count("download", "ok")
+    sent = _count(metrics.DEPENDENCY_BYTES, dependency="s3", operation="upload")
+    received = _count(metrics.DEPENDENCY_BYTES, dependency="s3", operation="download")
+
+    store.save_artifact("evt-1", "fetched_logs.txt", "a trace")
+    assert store.load_artifact("evt-1", "fetched_logs.txt") == "a trace"
+
+    assert _s3_count("upload", "ok") == uploads + 1
+    assert _s3_count("download", "ok") == downloads + 1
+    assert _count(metrics.DEPENDENCY_BYTES, dependency="s3", operation="upload") == sent + 7
+    assert _count(metrics.DEPENDENCY_BYTES, dependency="s3", operation="download") == received + 7
+
+
+def test_an_absent_s3_key_is_an_answer_not_an_error(monkeypatch):
+    """Every new packet probes for a casebook that is not there yet."""
+    store = _s3(monkeypatch)
+    absent, heads = _s3_count("download", "not_found"), _s3_count("head", "not_found")
+
+    errors = _increments(metrics.DEPENDENCY_ERRORS, lambda: (
+        store.load("evt-new"), store.artifact_exists("evt-new", "fetched_logs.txt")))
+
+    assert errors == {}
+    assert _s3_count("download", "not_found") == absent + 1
+    assert _s3_count("head", "not_found") == heads + 1
+
+
+def test_a_refused_s3_read_is_an_error_named_by_its_code(monkeypatch):
+    store = _s3(monkeypatch, FakeS3(fail_reads=True))
+
+    errors = _increments(metrics.DEPENDENCY_ERRORS, lambda: store.load("evt-1"))
+
+    assert errors == {(("dependency", "s3"), ("error", "AccessDenied"),
+                       ("operation", "download")): 1}
+
+
+def test_a_create_another_writer_won_is_a_conflict(monkeypatch):
+    store = _s3(monkeypatch)
+    conflicts = _s3_count("upload", "conflict")
+
+    assert store.create_json("evt-1", "claims/one.json", {"n": 1}) is True
+    assert store.create_json("evt-1", "claims/one.json", {"n": 2}) is False
+
+    assert _s3_count("upload", "conflict") == conflicts + 1
+
+
+def test_an_s3_listing_is_counted(monkeypatch):
+    store = _s3(monkeypatch)
+    store.create_json("evt-1", "claims/one.json", {"n": 1})
+    listings = _s3_count("list", "ok")
