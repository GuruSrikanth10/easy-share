+    monkeypatch.setattr(dlq_publisher, "get_producer", lambda: None)
+
+    def publish():
+        with pytest.raises(RuntimeError, match="not available"):
+            dlq_publisher.publish_to_dlq({"eventId": "evt-1"}, "boom")
+
+    assert _increments(metrics.DEPENDENCY_ERRORS, publish) == {
+        (("dependency", "kafka"), ("error", "RuntimeError"), ("operation", "publish_dlq")): 1}
+
+
+def test_a_publish_the_broker_did_not_confirm_is_named_by_its_error(monkeypatch):
+    from kafka.errors import KafkaTimeoutError
+
+    from src.utils import dlq_publisher
+
+    monkeypatch.setattr(dlq_publisher, "get_producer",
+                        lambda: _producer(error=KafkaTimeoutError("no ack")))
+
+    def publish():
+        with pytest.raises(KafkaTimeoutError):
+            dlq_publisher.publish_to_dlq({"eventId": "evt-1"}, "boom")
+
+    assert _increments(metrics.DEPENDENCY_ERRORS, publish) == {
+        (("dependency", "kafka"), ("error", "KafkaTimeoutError"),
+         ("operation", "publish_dlq")): 1}
