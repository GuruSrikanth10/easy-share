+# ======================================================================
+# Kafka publishes
+# ======================================================================
+
+def _producer(error=None):
+    future = MagicMock()
+    if error is not None:
+        future.get.side_effect = error
+    else:
+        future.get.return_value = SimpleNamespace(serialized_value_size=120)
+    producer = MagicMock()
+    producer.send.return_value = future
+    return producer
+
+
+def test_a_confirmed_publish_is_counted_with_its_size(monkeypatch):
+    from src.utils import analysis_queue_publisher as publisher
+
+    monkeypatch.setattr(publisher, "get_producer", lambda: _producer())
+    published = _count(metrics.DEPENDENCY_REQUESTS, dependency="kafka",
+                       operation="publish_analysis", outcome="ok")
+    size = _count(metrics.DEPENDENCY_BYTES, dependency="kafka", operation="publish_analysis")
+
+    assert publisher.publish_to_analysis_queue({"eventId": "evt-1"}) is True
+
+    assert _count(metrics.DEPENDENCY_REQUESTS, dependency="kafka",
+                  operation="publish_analysis", outcome="ok") == published + 1
+    assert _count(metrics.DEPENDENCY_BYTES, dependency="kafka",
+                  operation="publish_analysis") == size + 120
+
